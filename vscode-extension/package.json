{
  "name": "alloyx-vscode",
  "displayName": "AlloyX",
  "description": "Run Salesforce Apex locally and catch type errors as you type — powered by the allx CLI.",
  "version": "0.1.0",
  "publisher": "alloyx",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/colatusso/alloyx.git"
  },
  "bugs": {
    "url": "https://github.com/colatusso/alloyx/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Other"
  ],
  "keywords": [
    "apex",
    "salesforce",
    "local development",
    "soql",
    "transpiler"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:apex",
    "workspaceContains:**/*.cls"
  ],
  "contributes": {
    "commands": [
      {
        "command": "alloyx.runMethod",
        "title": "AlloyX: Run Apex Method"
      },
      {
        "command": "alloyx.runMethodAtCursor",
        "title": "AlloyX: Run Method"
      },
      {
        "command": "alloyx.runBuffer",
        "title": "AlloyX: Run"
      },
      {
        "command": "alloyx.syncSchema",
        "title": "AlloyX: Sync Org Schema"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "alloyx.runMethodAtCursor",
          "when": "resourceExtname == .cls",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "alloyx.runMethod",
          "when": "false"
        },
        {
          "command": "alloyx.runBuffer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AlloyX",
      "properties": {
        "alloyx.cliPath": {
          "type": "string",
          "default": "allx",
          "description": "Path to the allx CLI binary. Defaults to 'allx' (resolved via PATH)."
        },
        "alloyx.org": {
          "type": "string",
          "default": "",
          "description": "Salesforce org alias (from the sf CLI) to use when a run does SOQL/DML/sObject. Passed as --org. Leave empty to fall back to alloyx.json."
        },
        "alloyx.checkDelayMs": {
          "type": "number",
          "default": 1500,
          "description": "Idle time (ms) after typing stops before re-checking a .cls for errors."
        },
        "alloyx.javaHome": {
          "type": "string",
          "default": "",
          "description": "Path to the JDK (JAVA_HOME) used to run allx. Needed when VS Code is launched from the GUI and can't see your shell's JAVA_HOME. Example: /Users/you/.jdks/jdk-21.0.11+10/Contents/Home"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "reinstall": "vsce package --no-dependencies && code --install-extension alloyx-vscode-0.1.0.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
